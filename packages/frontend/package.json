{
  "name": "@gsuite/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --success first -n emulators,vite \"yarn emulators\" \"wait-on tcp:127.0.0.1:8080 tcp:127.0.0.1:9099 tcp:127.0.0.1:4000 && vite\"",
    "dev:no-seed": "concurrently --success first -n emulators,vite \"yarn emulators:no-seed\" \"wait-on tcp:127.0.0.1:8080 tcp:127.0.0.1:9099 tcp:127.0.0.1:4000 && vite\"",
    "dev:all": "concurrently --success first -n shared,functions,emulators,vite \"yarn workspace @gsuite/shared dev\" \"yarn workspace @gsuite/functions build:watch\" \"yarn emulators\" \"wait-on tcp:127.0.0.1:8080 tcp:127.0.0.1:9099 tcp:127.0.0.1:4000 && vite\"",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed-firestore.ts",
    "emulators": "yarn workspace @gsuite/firebase emulators",
    "emulators:no-seed": "yarn workspace @gsuite/firebase emulators:no-seed",
    "cleanup": "rm -rf ./seed/temp/*firebase-export-*"
  },
  "dependencies": {
    "@f0c1s/escape-html": "^2025.4.12",
    "@gsuite/shared": "workspace:*",
    "@linaria/core": "^8.2.0",
    "@mantine/carousel": "^9.6.1",
    "@mantine/charts": "^9.6.1",
    "@mantine/code-highlight": "^9.6.1",
    "@mantine/core": "^9.6.1",
    "@mantine/dates": "^9.6.1",
    "@mantine/dropzone": "^9.6.1",
    "@mantine/form": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@mantine/modals": "^9.6.1",
    "@mantine/notifications": "^9.6.1",
    "@mantine/nprogress": "^9.6.1",
    "@mantine/spotlight": "^9.6.1",
    "@mantine/vanilla-extract": "^9.6.1",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router": "0.0.1-beta.53",
    "@tinymce/tinymce-react": "^6.3.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.19.0",
    "js-beautify": "^2.0.3",
    "mantine-datatable": "^9.4.0",
    "mustache": "^4.2.0",
    "prismjs": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-simple-code-editor": "^0.14.1",
    "recharts": "3.10.1",
    "shiki": "^4.4.3",
    "tinymce": "^8.9.1",
    "tm-themes": "^1.12.11",
    "vkbeautify": "^0.99.3"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tanstack/router-plugin": "^1.168.40",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/js-beautify": "^1.14.3",
    "@types/jsdom": "^30.0.0",
    "@types/mustache": "^4.2.6",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vkbeautify": "^0.99.4",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@wyw-in-js/vite": "^2.5.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wait-on": "^9.1.0"
  }
}
