{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "rootDir": "./src",
    "noEmit": true,
    "paths": {
      "@/frontend/*": ["./src/*"],
      "@/shared/*": ["../shared/src/*"],
      "@/firebase/*": ["../firebase/*"],
      "@/functions/*": ["../functions/src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../shared" },
    { "path": "../firebase" },
    { "path": "./tsconfig.node.json" }
  ]
}
