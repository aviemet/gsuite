{
  "name": "@gsuite/firebase",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "emulators": "firebase emulators:start --import=./seed --export-on-exit=./seed",
    "emulators:no-seed": "firebase emulators:start",
    "functions:build": "cd functions && tsc --build",
    "functions:serve": "npm run functions:build && firebase emulators:start --only functions",
    "functions:deploy": "firebase deploy --only functions",
    "functions:logs": "firebase functions:log"
  },
  "dependencies": {
    "@gsuite/shared": "workspace:*",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.5.0"
  }
}
