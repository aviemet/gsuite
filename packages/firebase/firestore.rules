rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function membershipPath() {
      return /databases/$(database)/documents/memberships/$(request.auth.uid);
    }

    function signedIn() {
      return request.auth != null;
    }

    function isMember() {
      return signedIn() && exists(membershipPath());
    }

    function callerCustomerId() {
      return get(membershipPath()).data.customerId;
    }

    match /memberships/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /customers/{customerId} {
      allow read: if isMember() && callerCustomerId() == customerId;
      allow write: if false;

      match /invites/{inviteId} {
        allow read: if isMember() && callerCustomerId() == customerId;
        allow write: if false;
      }
    }

    match /templates/{templateId} {
      allow read: if isMember() && resource.data.customerId == callerCustomerId();
      allow write: if false;
    }

    match /templateAssignments/{assignmentId} {
      allow read: if isMember() && resource.data.customerId == callerCustomerId();
      allow write: if false;
    }

    match /signatureDeployLogs/{deployId} {
      allow read: if isMember() && resource.data.customerId == callerCustomerId();
      allow write: if false;
    }

    match /userSettings/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
